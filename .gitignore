# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# --- palm-roguelike ---
# Locally built patched pilrc (see tools/build-pilrc.sh)
tools/pilrc/

# kMoria build outputs
kMoria/src/*.o
kMoria/src/*.bin
kMoria/src/*.grc
kMoria/src/bin.stamp
kMoria/src/kMoria
kMoria/src/kMoria-sections.s
kMoria/src/kMoria-sections.ld
kMoria/src/kMoria.prc
kMoria/src/compat/

# iRogue build outputs
iRogue/src/*.o
iRogue/src/*.bin
iRogue/src/*.grc
iRogue/src/bin.stamp
iRogue/src/iRogue
iRogue/src/iRogue-sections.s
iRogue/src/iRogue-sections.ld
iRogue/src/iRogue.prc
iRogue/src/compat/

# iLarn build outputs
iLarn/src/*.o
iLarn/src/*.bin
iLarn/src/*.grc
iLarn/src/bin.stamp
iLarn/src/iLarn
iLarn/src/iLarn-sections.s
iLarn/src/iLarn-sections.ld
iLarn/src/iLarn.prc

.DS_Store

# Palm databases and other CVS-era files are source assets here, not build junk
!kMoria/**/*.pdb
!iLarn/**/*.pdb
!kMoria/src/BuildDB/foo.out
