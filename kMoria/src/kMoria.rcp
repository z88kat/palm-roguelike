FORM ID HwButtonsForm AT (2 2 156 156)
USABLE
MODAL
HELPID ButtonsStr
DEFAULTBTNID btn_hwb_cancel
BEGIN
  TITLE "Rebind Buttons"
  BUTTON "Ok" ID btn_hwb_ok AT (5 141 35 AUTO)
  BUTTON "Cancel" ID btn_hwb_cancel AT (PrevRight+7 PrevTop 35 AUTO)

  CHECKBOX "Rebind these buttons:" ID check_hwb AT (4 15 AUTO AUTO)

  LIST "---" "north" "south" "east" "west"
       "map" "look" "inventory" "magic/pray" "search"
       "srch mode" "rest" "dig tunnel" "force/bash" "open door"
       "close door" "spike door" "font" "stats" "exchange"
       "throw" "aim wand" "zap staff" "what's that" "next sector"
       "again" "RUN"
     ID list_hwb_1 AT (100 PrevBottom+1 55 110) VISIBLEITEMS 10

  PUSHBUTTON "Date" ID pbtn_hwb_0 AT (3 PrevTop 35 11) USABLE GROUP 1
  PUSHBUTTON "Addr" ID pbtn_hwb_1
     AT (PrevLeft PrevBottom+1 PrevWidth PrevHeight) USABLE GROUP 1
  PUSHBUTTON "To Do" ID pbtn_hwb_2
     AT (PrevLeft PrevBottom+1 PrevWidth PrevHeight) USABLE GROUP 1
  PUSHBUTTON "Memo" ID pbtn_hwb_3
     AT (PrevLeft PrevBottom+1 PrevWidth PrevHeight) USABLE GROUP 1
  PUSHBUTTON "Up" ID pbtn_hwb_4
     AT (PrevLeft PrevBottom+1 PrevWidth PrevHeight) USABLE GROUP 1
  PUSHBUTTON "Down" ID pbtn_hwb_5
     AT (PrevLeft PrevBottom+1 PrevWidth PrevHeight) USABLE GROUP 1
  PUSHBUTTON "Calc" ID pbtn_hwb_6
     AT (PrevLeft PrevBottom+1 PrevWidth PrevHeight) USABLE GROUP 1
  PUSHBUTTON "Find" ID pbtn_hwb_7
     AT (PrevLeft PrevBottom+1 PrevWidth PrevHeight) USABLE GROUP 1

END

FORM ID SpellHwBtnsForm AT (2 2 156 156)
USABLE
MODAL
DEFAULTBTNID btn_shwb_ok
BEGIN
  TITLE "Spell Buttons"
  BUTTON "Done" ID btn_shwb_ok AT (5 141 35 AUTO)

  PUSHBUTTON "Date" ID pbtn_shwb_0 AT (3 15 35 11) USABLE GROUP 1
  PUSHBUTTON "Addr" ID pbtn_shwb_1
     AT (PrevLeft PrevBottom+1 PrevWidth PrevHeight) USABLE GROUP 1
  PUSHBUTTON "To Do" ID pbtn_shwb_2
     AT (PrevLeft PrevBottom+1 PrevWidth PrevHeight) USABLE GROUP 1
  PUSHBUTTON "Memo" ID pbtn_shwb_3
     AT (PrevLeft PrevBottom+1 PrevWidth PrevHeight) USABLE GROUP 1
  PUSHBUTTON "Up" ID pbtn_shwb_4
     AT (PrevLeft PrevBottom+1 PrevWidth PrevHeight) USABLE GROUP 1
  PUSHBUTTON "Down" ID pbtn_shwb_5
     AT (PrevLeft PrevBottom+1 PrevWidth PrevHeight) USABLE GROUP 1
  PUSHBUTTON "Calc" ID pbtn_shwb_6
     AT (PrevLeft PrevBottom+1 PrevWidth PrevHeight) USABLE GROUP 1
  PUSHBUTTON "Find" ID pbtn_shwb_7
     AT (PrevLeft PrevBottom+1 PrevWidth PrevHeight) USABLE GROUP 1

  LIST " " ID list_shwb_1 AT (50 15 100 99)

  BUTTON "-None-" ID btn_shwb_clear AT (PrevLeft PrevBottom+3 AUTO AUTO)

  POPUPTRIGGER "Mage 0" ID popup_shwb_2 AT (100 PrevBottom+10 44 AUTO) LEFTANCHOR
  LIST "Mage 0" "Mage 1" "Mage 2" "Mage 3" "Priest 0" "Priest 1" "Priest 2" "Priest 3" ID list_shwb_2 AT (PrevLeft+10 PrevTop 34 1) NONUSABLE VISIBLEITEMS 8

  POPUPLIST ID popup_shwb_2 list_shwb_2

END


FORM ID LookForm AT (0 0 160 160)
USABLE
NOFRAME
DEFAULTBTNID btn_look_exit
BEGIN
    BUTTON "X" ID btn_look_exit AT (140 147 AUTO AUTO)
    BUTTON "R" ID btn_look_recall AT (PrevLeft-20 PrevTop AUTO AUTO) NONUSABLE
