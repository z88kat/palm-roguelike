#define ROW_4_line (ROW_4-2)

static void print_dnd_stat(Char *buf, Short stat)
{
  if (stat < 19)
    StrPrintF(buf, "%d", stat);
  else {
    stat -= 18;
    if (stat > 100) stat = 0; // 18/00 == 18/100 in MY world.
    if (stat < 10)
      StrPrintF(buf, "18/0%d", stat);
    else 
      StrPrintF(buf, "18/%d", stat);
  }
}

