#include "Pilot.h"

/*
 *	routine to take a nap for n milliseconds  - not very exciting.
 */
void nap(Short x)
{
  Short delay = SysTicksPerSecond(); /* we want ticks * n / 1000 */
  if (x <= 0) return;
  /* also, "make sure the output buffer is flushed" */
  if (x < 1000) {
    delay *= x;
    delay /= 1000;
  } else {
    x /= 1000; /* this will truncate but who cares */
    delay *= x;
  }
  SysTaskDelay(delay);
}
