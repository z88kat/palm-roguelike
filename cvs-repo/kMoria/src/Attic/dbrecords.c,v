void newrec_text(ULong uniqueID, Short qty, Short sze, Char **text) {
  VoidHand rec;
  Ptr p;
  Int size;
  UInt index;
  Short i, offset;
  index = DmNumRecords(MoriaDB);
  size = qty * sze;
  rec = DmNewRecord(MoriaDB, &index, size);
  p = MemHandleLock(rec);
  // print stuff to it.
  for (i = 0, offset = 0 ; i < qty; i++, offset += sze)
    DmWrite(p, offset, text[i], sze);
  MemPtrUnlock(p);
  DmReleaseRecord(MoriaDB, index, true);
  DmSetRecordInfo(MoriaDB, index, NULL, &uniqueID); // set its uid!
}
