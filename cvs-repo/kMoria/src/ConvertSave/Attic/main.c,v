// We will write:
// version info; recall info; some flags; ...
void write_version_info(FILE *fout)
{
  // We are writing for (major.minor.patchlevel) 5.5.2.
  unsigned char uc;
  uc = 5;  fwrite(&uc, 1, 1, fout);
  uc = 5;  fwrite(&uc, 1, 1, fout);
  uc = 2;  fwrite(&uc, 1, 1, fout);
  // now we write a byte with which umoria expects all else to be xor'ed:
  // it will make debugging o-so-much easier if this remains "0" for a while.
  uc = xb;  fwrite(&uc, 1, 1, fout);  
  // Ok done with the version header!
}
#define MAX_CREATURES 279
void write_recall(FILE *fout, FILE *fin)
{
  int j;
  unsigned short i, stop_here = 0xffff;
  // for each creature in MAX_CREATURES,
  // if we have any info about them,
  // (if anything OTHER than wake/ignore is non-zero)
  // write the uint of its index in this for-loop,
  // then write:  (cmove, spells), (kills, deaths, cdefense),
  // (wake, ignore), (rattacks[]).
  // finally, write a uint with all bits on, to signal the end.
  // ...
  fseek(fin, offsets[O_RECALL], SEEK_SET);
  for (i = 0 ; i < MAX_CREATURES ; i++) {
    unsigned long ul[2];
    unsigned short us[3];
    unsigned char uc[6];
    // What we are reading from:
    // An array of recall_type:  2ulong, 3ushort, 2uchar, 4uchar.
    // Except for those 2uchar, we care about the others being nonzero.
    for (j=0 ; j<2 ; j++)  ul[j] = in_long(fin);
    for (j=0 ; j<3 ; j++)  us[j] = in_word(fin);
    fread(uc, 1, 6, fin); // hm hope that works.
    // Ok now decide whether to write
    if (ul[0] || ul[1] || us[0] || us[1] || us[2] || /*uc0,uc1 uninteresting*/
	uc[2] || uc[3] || uc[4] || uc[5]) {
#ifdef VERYNOISY
      printf("printing monster %d\n", i);
#endif
      xwrite_sh(fout, &i, 1);
      xwrite_lo(fout, ul, 2);
      xwrite_sh(fout, us, 3);
      xwrite_by(fout, uc, 6);
    } else {
#ifdef VERYNOISY
      printf("SKIPPING monster %d\n", i);
#endif
    }
  }
  xwrite_sh(fout, &stop_here, 1);
}

void write_flags_1(FILE *fout, FILE *fin)
{
  // Write the following flags:
  // find_cut, find_examine, find_prself, find_bound,
  // prompt_carry_flag, rogue_like_commands, show_weight_flag,
  // highlight_seams, find_ignore_doors, sound_beep_flag, display_counts.
  // in fact for all these flags, we can say nothing useful, because they
  // are all stored in kMoria's Preferences!
  // The sign bit is 'death' - but kMoria does not write saves for dead guys.
  // The next-to-sign bit is total_winner - this, we DO have in save file.
  long flags_1 = 0;
  // I think I will turn on rogue-like commands:
  flags_1 |= 0x20;
  // we can find total_winner in my_save_struct.
  // which is buried in REC_PY.
  // skip misc, stats, flags, player_hp, spell_order; then
  // skip 8dword + 6word, and read an unsigned char (== a Boolean).
  if (0) {
    flags_1 |= 0x40000000L;
#ifdef NOISY
    printf("(congratulations, winner)\n");
#endif
  }
  xwrite_lo(fout, &flags_1, 1);
}
#define PLAYER_NAME_SIZE 27
// Called by write_py_etc:
void write_player_misc(FILE *fout, FILE *fin)
{
  unsigned char name[PLAYER_NAME_SIZE];
  // we are seeked within a record, thanks to caller.  at pymisc.
  // need to write: everything, in the same order as our inputfile.
  fread(name, 1, PLAYER_NAME_SIZE, fin);
  name[PLAYER_NAME_SIZE-1] = '\0';
#ifdef NOISY
  {
    printf("name of character is: '%s'\n", name);
  }
#endif
  xwrite_str(fout, name, PLAYER_NAME_SIZE);
  // write one boolean (unsigned char)
  xcopy_by(fout, fin, 1);
  // write 3 (signed) longs
  xcopy_lo(fout, fin, 3);
  // write 24 shorts (first 6 are unsigned)
  xcopy_sh(fout, fin, 24);
  // write 4 unsigned chars, and then 4 shorts.
  xcopy_by(fout, fin, 4);
  xcopy_sh(fout, fin, 4);
  // whew, we are done.
}
