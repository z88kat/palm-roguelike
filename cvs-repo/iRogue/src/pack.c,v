void kick_into_pack() {
  fighter *rogue = sotu->roguep;
  object *obj;
  Char desc[DCOLS];
  Short n, status;

  if (sotu->levitate || (sotu->ring_flags & RING_LEVITATE)) {
    message("you're floating in the air!", sotu);
