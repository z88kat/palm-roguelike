  int j;
  short tmp;
  char inscript[13];
  // write out the inventory item
  xcopy_sh(fout, fin, 1); // index
  xcopy_by(fout, fin, 1); // name2
  fread(inscript, 1, 13, fin);
  xwrite_str(fout, inscript, 13);
  xcopy_lo(fout, fin, 1); // flags
  xcopy_by(fout, fin, 2); // t..
  xcopy_sh(fout, fin, 1);
  xcopy_lo(fout, fin, 1); // cost
  xcopy_by(fout, fin, 2); // sv,#
  xcopy_sh(fout, fin, 1); // w
  fread(inscript, 1, 4, fin);
  // note: tohit, todam, ac, toac must be expanded back into shorts.
  for (j=0 ; j<4 ; j++) {
    tmp = inscript[j];
    xwrite_sh(fout, &tmp, 1);
  }
  xcopy_by(fout, fin, 4); // dmg(2),lv,id
}
void skip_invy_item(FILE *fin)
{
  long position = ftell(fin);
  position += INVEN_TYPE__SIZE;
  fseek(fin, position, SEEK_SET);
}
void write_inventory(FILE *fout, FILE *fin, int inven_ctr)
{
  int i;
  long position;
  fseek(fin, offsets[O_INVENTORY], SEEK_SET);
  position = ftell(fin);
  for (i = 0 ; i < INVEN_ARRAY_SIZE ; i++) {
    if ((i >= inven_ctr) && (i < INVEN_WIELD)) {
      i = INVEN_WIELD; // skip blanks in the middle.
      fseek(fin, position + INVEN_WIELD * INVEN_TYPE__SIZE, SEEK_SET);
    }
    write_invy_item(fout, fin);
  }
}
#define OBJECT_IDENT_SIZE 448
void write_objident(FILE *fout, FILE *fin)
{
  fseek(fin, offsets[O_OBJIDENT], SEEK_SET);
  xcopy_by(fout, fin, OBJECT_IDENT_SIZE);
}
#define MAX_SAVE_MSG 22
void write_old_msgs(FILE *fout, FILE *fin)
{
  char buf[80];
  int i;
  short lastm = 0;
  sprintf(buf, "deadbeef");
  xwrite_sh(fout, &lastm, 1);
  for (i=0 ; i<MAX_SAVE_MSG ; i++)
    xwrite_str(fout, buf, 80);
}
void write_inventory_thru_php(FILE *fout, FILE *fin)
{
  short inven_ctr = my_save.us[1];
  unsigned short us = 0;
  // pick up where py_etc left off.  after reading my_save and floor_save.
  xwrite_sh(fout, &my_save.us[0], 1); // missile ctr
  xwrite_lo(fout, &my_save.ul[6], 1); // turn
  xwrite_sh(fout, &inven_ctr, 1);
  write_inventory(fout, fin, inven_ctr);
  xwrite_sh(fout, &my_save.us[2], 2); // inven_weight, equip_ctr
  xwrite_lo(fout, &my_save.ul[0], 3); // spell{_learned, _worked, _forgotten}
  write_spell_order(fout, fin);
  write_objident(fout, fin);
  // there's a bit of a problem here: I always skip randes_seed.
  xwrite_lo(fout, &my_save.ul[3], 1); // copy town_seed into randes_seed.
  xwrite_lo(fout, &my_save.ul[3], 1); // town_seed proper.
  write_old_msgs(fout, fin);
  // panic save, total winner, noscore...
  us = 0; // panic save == false
  xwrite_sh(fout, &us, 1);
  us = my_save.uc[0]; // total winner
  xwrite_sh(fout, &us, 1);
  us = 0; // noscore == false  
  xwrite_sh(fout, &us, 1);
  write_player_hp(fout, fin);
}
// Things seem ok up to this point.

#define MAX_STORES 6
#define STORE_TYPE__SIZE 12
void write_stores(FILE *fout, FILE *fin)
{
  // For each store,
  //   print the store struct,
  //   and then print its items
  int i, j;
  unsigned char inv_ctr;
  for (i=0 ; i<MAX_STORES ; i++) {
    // goto store
    fseek(fin, offsets[O_STORES] + i * STORE_TYPE__SIZE, SEEK_SET);
    xcopy_lo(fout, fin, 1);
    xcopy_sh(fout, fin, 1);
    xcopy_by(fout, fin, 1);
    fread(&inv_ctr, 1, 1, fin);
    xwrite_by(fout, &inv_ctr, 1);
    xcopy_sh(fout, fin, 2);
    // goto store inventory
    fseek(fin, offsets[O_STOREINV_1 + i], SEEK_SET);
    for (j=0 ; j<inv_ctr ; j++) {
      xcopy_lo(fout, fin, 1); // scost
      write_invy_item(fout, fin); // will this work?  too tired to think.
    }
  }
}

void write_character_tail(FILE *fout, FILE *fin)
{
  xwrite_lo(fout, &my_save.ul[4], 1); // save timestamp
  xwrite_str(fout, my_save.died_from, 25);
  xwrite_lo(fout, &my_save.ul[7], 1); // max points
  xwrite_lo(fout, &my_save.ul[5], 1); // birth timestamp
  // Then we are done with CHARACTER but still need DUNGEON
}

void write_character(FILE *fout, FILE *fin)
{
  write_recall(fout, fin);
  write_flags_1(fout, fin);
  write_py_etc(fout, fin);
  // now it gets a bit more scrambled
  write_inventory_thru_php(fout, fin);
  // things seem ok up through player_hp....
  write_stores(fout, fin);
  write_character_tail(fout, fin);
  // DONE with character.... still need dungeon ....
}

void write_floor(FILE *fout, FILE *fin)
{
  xwrite_sh(fout, floor_save.us, 8); // the whole thing
}
#define MAX_HEIGHT 66
#define MAX_WIDTH 198
// Hmmmm I see a potential for problems here if these are not #defined
// the same in your target umoria.  fortunately these seem to be default still.
// Actually, perhaps max_panel_rows and max_panel_cols will be unhappy?
void write_packed_cptr_tptr(FILE *fout, FILE *fin)
{
  unsigned char i, j, o_index, xptr;
  for (o_index = O_CPTR ; o_index <= O_TPTR ; o_index++) {
    fseek(fin, offsets[o_index], SEEK_SET);
    for (i=0 ; i<MAX_HEIGHT ; i++) {
      for (j=0 ; j<MAX_WIDTH ; j++) {
	fread(&xptr, 1, 1, fin); // k == i * MAX_WIDTH + j
	if (xptr!=0) {
	  xwrite_by(fout, &i, 1);
	  xwrite_by(fout, &j, 1);
	  xwrite_by(fout, &xptr, 1);
	}
      }
    }
    xptr = 0xff; // mark end
    xwrite_by(fout, &xptr, 1);
  }
}
void write_packed_flval(FILE *fout, FILE *fin)
{
  // This one is run-length encoded.
  unsigned char lightfval, old_lightfval=0, fval, light, run=0;
  long position_f, position_l;
  int k;

  // what do we do here:
  // walk through the dungeon, writing fval | light stuff.
  // Fortunately, my 'light' byte has the bits in the same order as the
  // save file's light byte (tl, pl, fm, lr).
  // Light gets to be the high four and fval the low four.
  position_f = offsets[O_FVAL];
  position_l = offsets[O_LIGHT];
  for (k=0 ; k<MAX_HEIGHT*MAX_WIDTH ; k++) {
    // get fval
    fseek(fin, position_f, SEEK_SET);
    fread(&fval, 1, 1, fin);
    position_f = ftell(fin);
    // get light
    fseek(fin, position_l, SEEK_SET);
    fread(&light, 1, 1, fin);
    position_l = ftell(fin);
    // combine
    lightfval = (((light << 4) & 0xf0) | (fval & 0x0f));
#ifdef VERYNOISY
    {
      if (light > 1)
	printf("light %x fval %x lightfval %x\n", light, fval, lightfval);
    }
#endif
    // if same as previous, skip
    if ((lightfval == old_lightfval) && (run < 255)) {
      run++;
      continue;
    }
    // On the first pass, run==0 and old_lf==0 and we will write both out
    // (since the read-in lf will be nonzero).  After that, all is normal.
    xwrite_by(fout, &run, 1);
    run = 1; // we've read one 'lightfval' just now, so 'run' so far is 1
    xwrite_by(fout, &old_lightfval, 1);
    old_lightfval = lightfval;
  }
  // we must output the last one at the end
  xwrite_by(fout, &run, 1);
  xwrite_by(fout, &old_lightfval, 1);
  // done!  I think.
}
void write_tlist(FILE *fout, FILE *fin)
{
  int i;
  short tcptr = my_save.us[4];
  // write tcptr
#ifdef NOISY
  printf("tcptr = %d\n", tcptr);
#endif
  xwrite_sh(fout, &tcptr, 1);
  fseek(fin, offsets[O_TLIST], SEEK_SET);
  // write each item in t_list ... this is yet-another inven type.
  // SKIP the first one, though: it's just 0
  skip_invy_item(fin);
  for (i=1 ; i<tcptr ; i++) {
    write_invy_item(fout, fin);
  }
}
void write_mlist(FILE *fout, FILE *fin)
{
  int i;
  short mfptr = my_save.us[5];
  long monsize = sizeof(short)*4 + sizeof(unsigned char)*6;
  // write mfptr
#ifdef NOISY
  printf("mfptr = %d\n", mfptr);
#endif
  xwrite_sh(fout, &mfptr, 1);
  fseek(fin, offsets[O_MLIST] + 2*monsize, SEEK_SET);
  // write each monster in m_list  (skip the first two!!)
  for (i=2 ; i<mfptr ; i++) {
    xcopy_sh(fout, fin, 4);
    xcopy_by(fout, fin, 6);
  }
}

void write_dungeon(FILE *fout, FILE *fin)
{
  write_floor(fout, fin);
  write_packed_cptr_tptr(fout, fin);
  write_packed_flval(fout, fin);
  // skip the msdos thing
  write_tlist(fout, fin);
  write_mlist(fout, fin);
  // and then we are DONE!
}
