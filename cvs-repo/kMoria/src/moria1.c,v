  if (posn >= 0)
    StrPrintF(out_val, "%s%s (%c)", p, prt2, (Char)(posn+'a'));
  else
    StrPrintF(out_val, "%s%s", p, prt2);
  message(out_val);
  if (item_val != INVEN_AUX)	  /* For secondary weapon  */
    py_bonuses(t_ptr, -1);
  invcopy(inventory, item_val, OBJ_NOTHING);
}



