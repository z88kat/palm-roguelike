// The player titles are stored in a (read-only) record
// i.e. I will need an application to print them to it,
// Moria will only need to read from it.
// This table is used for ...
// 'buf' must have at least 14 chars
/*
 *  newrec_playertitle
 *  REQUIRES: the player titles, above;  no REC_PLAYERTITLE in main db
 *  RESULT:   record is created and initialized with that data
 */
void newrec_playertitle() {
  VoidHand rec;
  Ptr p;
  Int size;
  UInt index;
  ULong uniqueID = REC_PLAYERTITLE;
  Short i, j, offset;
  index = DmNumRecords(MoriaDB);
  size = MAX_CLASS * MAX_PLAYER_LEVEL * MAXLEN_PLAYERTITLE;
  rec = DmNewRecord(MoriaDB, &index, size);
  p = MemHandleLock(rec);
  // print stuff to it.
  for (i = 0, offset = 0 ; i < MAX_CLASS; i++)
    for (j = 0 ; j < MAX_PLAYER_LEVEL ; j++, offset += MAXLEN_PLAYERTITLE)
      DmWrite(p, offset, player_title[i][j], MAXLEN_PLAYERTITLE);
  MemPtrUnlock(p);
  DmReleaseRecord(MoriaDB, index, true);
  DmSetRecordInfo(MoriaDB, index, NULL, &uniqueID); // set its uid!
}
/*
 *  copy_player_title
 *  IN: class & level of desired title, space to copy it
 *  REQUIRES: buf is large enough, record exists
 *  RESULT:   title is copied into buf (if class and level are in bounds)
 */
void copy_player_title(Short pclass, Short plevel, Char *buf)
{
  VoidHand rec;
  Ptr p;
  UInt index;
  ULong uniqueID = REC_MESSAGELOG;
  Char * str;
  // bounds check
  if (plevel < 0 || pclass < 0 ||
      pclass >= MAX_CLASS || plevel >= MAX_PLAYER_LEVEL)
    return 0;
  if (DmFindRecordByID(MoriaDB, uniqueID, &index)) return;
  rec = DmQueryRecord(MoriaDB, index);
  p = MemHandleLock(rec);
  str = (Char *) p;
  StrCopy(buf, str);
  MemHandleUnlock(rec);
}

