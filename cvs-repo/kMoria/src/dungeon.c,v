static Boolean enchanted(inven_type *t_ptr)
{
  if (t_ptr->tval < TV_MIN_ENCHANT ||
      t_ptr->tval > TV_MAX_ENCHANT ||
      t_ptr->flags & TR_CURSED)
    return false;
  if (known2_p(t_ptr))
