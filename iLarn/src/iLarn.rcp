FORM ID AboutForm AT (2 2 156 156)
USABLE
MODAL
HELPID AboutStr
DEFAULTBTNID btn_about_ok
BEGIN
	TITLE "About iLarn"
	FORMBITMAP AT (62 20) BITMAP bitmap_iLarn
	LABEL "iLarn v0.40  (24 Nov 2026)" AUTOID AT (Center 57) FONT 1
	LABEL "Based on Ularn" AUTOID AT (Center PrevTop+12)

	LABEL "Bugs?  Report them at:" AUTOID AT (Center 92)
	LABEL "github.com/z88kat/" AUTOID AT (Center PrevTop+11)
	LABEL "palm-roguelike" AUTOID AT (Center PrevTop+11)
	BUTTON "Done" ID btn_about_ok AT (6 139 44 AUTO)
	BUTTON "License" ID btn_about_more AT (PrevRight+6 PrevTop 44 AUTO)
	BUTTON "History" ID btn_about_credits AT (PrevRight+6 PrevTop 44 AUTO)
END

ALERT ID QuitP
WARNING
BEGIN
	TITLE "Really Quit?"
	MESSAGE "Do you really want to quit?  This will kill your current character."
	BUTTON "Ok" "No, don't quit!"
END

STRING CloneStr "If you are an inexperienced player, "\
	"you can make a clone of your character.  "\
	"Only one clone can exist at a time. "\
	"The clone can be revived only in Character Generation (instead "\
	"of creating a new character) and the clone record is destroyed "\
	"when the clone is revived.\n"\
	"Cloning is enabled for Difficulty Level 0 only, for "\
	"the benefit of beginners.\n\n"\
	"It is not possible to clone the Eye of Larn or the potion of "\
	"Cure Dianthroritis.  "\
	"Also, clones are destroyed when any character wins."

ALERT ID CloneP
CONFIRMATION
HELPID CloneStr
BEGIN
	TITLE "Send In The Clones"
	MESSAGE "Tap Ok to ^1"
	BUTTON "Ok" "Cancel"
END

ALERT ID BeamNextP
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
	TITLE "Ready?"
	MESSAGE "Ready to beam the next piece?"
	BUTTON "Ok" "Cancel"
END

ALERT ID NoCloneP
INFORMATION
HELPID CloneStr
BEGIN
	TITLE "The gloves are off"
	MESSAGE "Cloning is enabled for Difficulty Level 0 only.  "\
	"Your current DL is: ^1."
	BUTTON "Ok"
END

