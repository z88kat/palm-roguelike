/*
 *  newrec_messagelog
 *  REQUIRES: no existing REC_MESSAGELOG in the save db
 *  RESULT:   new empty record of appropriate size
 */
void newrec_messagelog() {
  VoidHand rec;
  Ptr p;
  Int i, size;
  UInt index;
  ULong uniqueID = REC_MESSAGELOG;
  // The message log acts as a circular buffer
  // <newnewnew>.<oldoldold>
  // There should be a global indicating what is the next spot to use.
  // When printing the circular buffer in chronological order,
  // print that spot to the end, then print the beginning to spot-1.
  index = DmNumRecords(MoriaSaveDB);
  size = MAXLEN_MSG * MAX_MSGLOG;
  rec = DmNewRecord(MoriaSaveDB, &index, size);
  p = MemHandleLock(rec);
  DmSet(p, 0, size, 0);  // set it all to 0.  i think that will work.
  MemPtrUnlock(p);
  DmReleaseRecord(MoriaSaveDB, index, true);
  DmSetRecordInfo(MoriaSaveDB, index, NULL, &uniqueID); // set its uid!
}
/*
 *  add_message_to_log
 *  IN: your message 'msg', globals 'env'
 *  REQUIRES: existing REC_MESSAGELOG in the save db; msg is null-terminated.
 *  RESULT:   string is added to it; circular FIFO replacement
 */
void add_message_to_log(Char *msg, everything *env) {
  VoidHand rec;
  Ptr p;
  UInt index;
  ULong uniqueID = REC_MESSAGELOG;
  if (DmFindRecordByID(MoriaSaveDB, uniqueID, &index)) return;
  rec = DmGetRecord(MoriaSaveDB, index);
  p = MemHandleLock(rec);
  DmStrCopy(p, env->log_next * sizeof(MSGLOG_ENTRY), msg);
  MemPtrUnlock(p);
  DmReleaseRecord(MoriaSaveDB, index, true);
  env->log_next++;
}
/*
 *  pring_message_log
 *  IN: globals 'env'
 *  REQUIRES: existing REC_MESSAGELOG in the save db
 *  RESULT:   any strings in it will be printed
 */
void print_message_log(everything *env) {
  VoidHand rec;
  Ptr p;
  UInt index;
  ULong uniqueID = REC_MESSAGELOG;
  Short i;
  Char * msg;
  if (DmFindRecordByID(MoriaSaveDB, uniqueID, &index)) return;
  rec = DmQueryRecord(MoriaSaveDB, index);
  p = MemHandleLock(rec);
  msg = (Char *) p;
  for (i = env->log_next ; i < MSG_LOG_SIZE ; i++)
    message(msg + i * sizeof(MSGLOG_ENTRY)); // xxx fix this
  for (i = 0 ; i < env->log_next - 1 ; i++)
    message(msg + i * sizeof(MSGLOG_ENTRY)); // xxx fix this
  MemPtrUnlock(p);
}

