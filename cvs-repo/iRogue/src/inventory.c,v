  Short i, j, k;
  Char t[32];

  for (i = 0; i <= 32; i++) {
    j = get_rand(0, (POTIONS - 1));
    k = get_rand(0, (POTIONS - 1));
    if (j != k) {
      StrCopy(t,                         sotu->id_potions[j].title);
      StrCopy(sotu->id_potions[j].title, sotu->id_potions[k].title);
      StrCopy(sotu->id_potions[k].title, t);
    }
