short in_word(FILE* fin)
{
  long m;
  fread(&m, 2, 1, fin);
  return SwapWord(m);
}
long in_long(FILE* fin)
{
  long d1;
  fread(&d1, 4, 1, fin);
  return SwapLong(d1);
}


///////////////////////////////////////////////////////////////////////

int TotalRecords;
// record entry descriptors

typedef struct {
  long offset;
  //  unsigned char attribs; // We don't actually care about these.
  long unique_id;
} rec_entry_descr;

rec_entry_descr *reds;

void read_preamble(FILE* fin)
{
  struct tDocHeader head1;
  int i;

  // The "Preamble" of the database has two parts.
  // First, there is a fixed-length header.  (head1).
  // Second, there is a list of record UIDs, attributes, & offsets.
  // 4 bytes of offset; 1 byte of record attribs; 3 bytes of unique id.

  printf("reading preamble...\n");
  fread(&head1, sizeof(head1), 1, fin);
  TotalRecords = SwapWord(head1.wNumRecs);
  printf("database name = %s, %d records\n", head1.sName, TotalRecords);

  fseek(fin, DOCHEADSZ, SEEK_SET); // get lined up for the second section..

  /*pi_file_get_entries (pf, &nentries);*/
  reds = (rec_entry_descr *) malloc(sizeof(rec_entry_descr)*TotalRecords);

  for (i = 0 ; i < TotalRecords ; i++) {
    long tmp;
    reds[i].offset = in_long(fin);
    tmp = in_long(fin);
    /* reds[i].attribs would be the 0xff000000 byte of tmp. */
    reds[i].unique_id = (tmp & 0x00ffffff);
  }

}


int
main(int argc, char** argv)
{
  FILE *fin, *fout;
  //  DWORD numRecs;
  //  int recNum = 0;
  //  struct rec0 r0;
  //  long start_position;

  printf("%s (for kMoria savefile-version 0x01 / Umoria 5.5.2)\n", argv[0]);
  if (argc < 3) {
    fprintf(stderr,"One-way save file conversion, from kMoriaSaveDB.pdb to moria.save\n");
    fprintf(stderr,"usage: %s in.pdb out.save\n",argv[0]);
    exit(2);
  }

  if ( ! SwapChoose()) {
    printf("\nfailed to select proper byte swapping algorithm");
#if UNIX
    printf("\n");
#endif
    exit(1);
  }

  fin = fopen(argv[1], "rb");
  if (fin==0) {
    printf("problem opening files\n");
    exit(2);
  }

  // we read in all the offsets and record uids.
  read_preamble(fin);

  sort_offsets(fin);

  // now, we consult umoria/source/save.c
  fout = fopen(argv[2], "wb");
  write_version_info(fout);
  write_character(fout, fin);
  write_dungeon(fout, fin);

  fclose(fin);
  fclose(fout);
  exit(0);
}


