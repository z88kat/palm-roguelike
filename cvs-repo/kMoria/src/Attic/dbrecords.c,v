/*****************************************************************************
 *                                                                           *
 *                    OpenMyDatabase                                         *
 *                                                                           *
 *****************************************************************************/
static Boolean OpenMyDatabase()
{
  LocalID dbID;

  // DELETE database, if any.
  dbID = DmFindDatabase(0, MoriaDBName); // card#, name
  if (dbID)
    if (DmDeleteDatabase(0, dbID)) // card#, id
      return 1;

  // create database
  if (DmCreateDatabase(0, MoriaDBName, MoriaAppID, MoriaDBType, false))
    return 1;

  // open database
  dbID = DmFindDatabase(0, MoriaDBName); // card#, name
  if (!dbID) return 1;
  MoriaDB = DmOpenDatabase(0, dbID, dmModeReadWrite);
  // we assume that opening a newly created db will work

  // Also, open (creating it if necessary) the MoriaSaveDB
  if (0 == (dbID = DmFindDatabase(0, MoriaSaveDBName))) {
    if (DmCreateDatabase(0, MoriaSaveDBName, MoriaAppID, MoriaSaveDBType,
			 false))
      return 1;
    if (0 == (dbID = DmFindDatabase(0, MoriaSaveDBName))) return 1;
  }
  if (0 == (MoriaSaveDB = DmOpenDatabase(0, dbID, dmModeReadWrite))) return 1;
  

  return 0;
}

