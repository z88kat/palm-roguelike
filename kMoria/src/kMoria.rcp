FORM ID PrefsForm AT (2 2 156 156)
USABLE
MODAL
HELPID PrefsHelpStr
DEFAULTBTNID btn_prf_cancel
BEGIN
   TITLE "Preference Settings"
   PUSHBUTTON "Display" ID pbtn_prf_0 AT (5 15 AUTO AUTO) USABLE GROUP 1
   PUSHBUTTON "Moving" ID pbtn_prf_1 AT (PrevRight+1 PrevTop AUTO PrevHeight) USABLE GROUP 1

   CHECKBOX "Big font." ID check_prf_1 AT (3 15+17 AUTO AUTO) NONUSABLE
   CHECKBOX "Sound." ID check_prf_4 AT (PrevLeft PrevTop+11 AUTO AUTO) NONUSABLE
   CHECKBOX "Invert (black background)." ID check_prf_13 AT (PrevLeft PrevTop+11 AUTO AUTO) NONUSABLE
   CHECKBOX "Color." ID check_prf_14 AT (PrevLeft PrevTop+11 AUTO AUTO) NONUSABLE
   CHECKBOX "Stats at top of screen." ID check_prf_12 AT (PrevLeft PrevTop+11 AUTO AUTO) NONUSABLE
   CHECKBOX "Highlight/notice mineral seams." ID check_prf_11 AT (PrevLeft PrevTop+11 AUTO AUTO) NONUSABLE
   CHECKBOX "Animate spells and missiles." ID check_prf_15 AT (PrevLeft PrevTop+11 AUTO AUTO) NONUSABLE
   CHECKBOX "Prompt for save file." ID check_prf_16 AT (PrevLeft PrevTop+11+5 AUTO AUTO) NONUSABLE
   CHECKBOX "Select most recent user." ID check_prf_17 AT (PrevLeft PrevTop+11 AUTO AUTO) NONUSABLE
	
	BUTTON "Ok" ID btn_prf_ok AT (5 141 35 AUTO)
	BUTTON "Cancel" ID btn_prf_cancel AT (PrevRight+7 PrevTop 35 AUTO)

   LABEL "Hole" label_prf_1 AT (105 13)
   LIST "10" "20" "30" "40" ID list_prf_1 AT (PrevLeft PrevBottom 15 44) VISIBLEITEMS 4 NONUSABLE
   LABEL "Donut" label_prf_2 AT (128 13)
   LIST "10" "20" "30" "40" ID list_prf_2 AT (PrevLeft+6 PrevBottom 15 44) VISIBLEITEMS 4 NONUSABLE

   CHECKBOX "Relative move." ID check_prf_2 AT (3 15+17 AUTO AUTO) NONUSABLE
   CHECKBOX "Show circles." ID check_prf_3 AT (PrevLeft PrevTop+11 AUTO AUTO) NONUSABLE
   CHECKBOX "Run." ID check_prf_5 AT (PrevLeft PrevTop+11+5 AUTO AUTO) NONUSABLE

   CHECKBOX "Cut known corners." ID check_prf_6 AT (PrevLeft+6 PrevTop+11 AUTO AUTO) NONUSABLE
   CHECKBOX "Examine potential corners." ID check_prf_7 AT (PrevLeft PrevTop+11 AUTO AUTO) NONUSABLE
   CHECKBOX "Stop when map sector changes." ID check_prf_8 AT (PrevLeft PrevTop+11 AUTO AUTO) NONUSABLE
   CHECKBOX "Run through open doors." ID check_prf_9 AT (PrevLeft-6 PrevTop+11 AUTO AUTO) NONUSABLE
   CHECKBOX "Prompt to pick up objects." ID check_prf_10 AT (PrevLeft PrevTop+11 AUTO AUTO) NONUSABLE

END



