#define INVEN_ARRAY_SIZE 34   /* Size of inventory array(Do not change)*/
#define MAX_OBJ_LEVEL  50     /* Maximum level of magic in dungeon     */
#define OBJ_GREAT      12     /* 1/n Chance of item being a Great Item */
