{
  message("*eat!*");
  message("Things start to get real spacey...!");
  env->cdude[HASTEMONST] += rnd(75) + 25;
  env->cdude[CONFUSE]    += 30 + rnd(10);
  env->cdude[WISDOM]   += 2;
  env->cdude[CHARISMA] += 2;
