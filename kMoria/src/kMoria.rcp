FORM ID AboutForm AT (2 2 156 156)
USABLE
MODAL
HELPID AboutStr
DEFAULTBTNID btn_about_ok
BEGIN
	TITLE "About kMoria"
	FORMBITMAP AT (62 20) BITMAP bitmap_moria
	LABEL "kMoria v0.16  (24 Nov 2026)" AUTOID AT (Center 57) FONT 1
	LABEL "Based on Moria 5.5.2" AUTOID AT (Center PrevTop+12)

	LABEL "Bugs?  Report them at:" AUTOID AT (Center 92)
	LABEL "github.com/z88kat/" AUTOID AT (Center PrevTop+11)
	LABEL "palm-roguelike" AUTOID AT (Center PrevTop+11)
	BUTTON "Done" ID btn_about_ok AT (6 139 44 AUTO)
	BUTTON "License" ID btn_about_more AT (PrevRight+6 PrevTop 44 AUTO)
	BUTTON "History" ID btn_about_credits AT (PrevRight+6 PrevTop 44 AUTO)
END

