#define MAX_MY_COLORS (MAX_CREATURES + MAX_ASCII + MAX_DEFAULTS)
// added...
static void ccolors_record_lock(Boolean unlocked)
{
  //  ULong uniqueID = ;
  static UInt index = REC_CLIST_COLORS;
  static VoidHand vh;
  ULong size = MAX_MY_COLORS * sizeof(IndexedColorType);
  VoidPtr p = NULL;
  if (unlocked) {
    // lock record
    //    if (0!=DmFindRecordByID(MoriaColorDB, uniqueID, &index)) {
    if (DmNumRecords(MoriaColorDB) <= REC_CLIST_COLORS) {
      // XXX will this do in the right order? blah.
      // create new record if it doesn't exist
      vh = DmNewRecord(MoriaColorDB, &index, size);
      p = MemHandleLock(vh);
      DmSet(p, 0, size, black); // happily, it's the right size, UChar.
    } else {
      vh = DmGetRecord(MoriaColorDB, index);
      //vh = DmResizeRecord(MoriaColorDB, index, size); // uncomment to resize
      p = MemHandleLock(vh);
    }
    c_colors = (IndexedColorType *) p;
  } else {
    // unlock record
    if (c_colors != NULL) {
      c_colors = NULL;
      MemHandleUnlock(vh);
      DmReleaseRecord(MoriaColorDB, index, true);
      //DmSetRecordInfo(MoriaColorDB, index, NULL, &uniqueID); // set its uid!
    }
  }
}
