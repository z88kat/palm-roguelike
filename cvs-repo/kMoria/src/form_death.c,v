Boolean Crown_Form_HandleEvent(EventPtr e)
{
  FormPtr frm;
  Boolean handled=false;
  switch (e->eType) {

  case frmOpenEvent:
    frm = FrmGetActiveForm();
#ifndef I_AM_OS_2
    if (IsVGA) PrvMoveForm(false);
#endif
    FrmDrawForm(frm);
    crown_draw();
    handled = true;
    break;

#ifndef I_AM_OS_2
  case displayExtentChangedEvent:
    if (IsVGA) PrvMoveForm(true);
    return true;
#endif

  case penDownEvent:
    LeaveForm();
    handled = true;
    break;
  default:
    break;
  }
  return handled;
}
