static void store_record_lock(Boolean unlocked)
{
  ULong uniqueID;
  static UInt index;
  static VoidHand vh;
  VoidPtr p;
  if (unlocked) {
    // lock record
    uniqueID = REC_STORES;
    if (0!=DmFindRecordByID(MoriaSaveDB, uniqueID, &index)) return;
    vh = DmGetRecord(MoriaSaveDB, index);
    p = MemHandleLock(vh);
    store = (store_type *) p;
  } else {
    // unlock record
    if (store != NULL) {
      store = NULL;
      MemHandleUnlock(vh);
      DmReleaseRecord(MoriaSaveDB, index, true);
    }
  }
