// Changed from 128 to 129.  Let's see if this fixes Kyocera's wagon.
FONT ID ItsyFont FONTID 129 "Font56.txt"

FORM ID MainForm AT (0 0 160 160)
USABLE
NOFRAME
MENUID MainFormMenu
BEGIN
    GRAFFITISTATEINDICATOR AT (150 150)
END

//        MENUITEM "Toggle Debug  "           ID menu_mainWiz
//	MENUITEM "Scroll View " ID  menu_mainScroll "V"
//	MENUITEM "Graffiti Help "        ID menu_mainGraffiti "G"
MENU ID MainFormMenu
BEGIN
    PULLDOWN "Options"
    BEGIN
        MENUITEM "Map  "           ID menu_mainMap "M"
	MENUITEM "Message Log   "          ID menu_mainMsgs "L"
	MENUITEM "Re-Center" ID  menu_mainCenter "C"
	MENUITEM "Change Font" ID  menu_main_test "F"
	MENUITEM SEPARATOR
        MENUITEM "High Scores"       ID menu_mainScores
        MENUITEM "Clone Me"       ID menu_mainSketch
	MENUITEM SEPARATOR
	MENUITEM "(Q)  QUIT" ID  menu_cmd_quit
    END
    PULLDOWN "Commands"
    BEGIN
	MENUITEM "(i)    Inventory..." ID  menu_cmd_i
	MENUITEM "(t)   Take off armor" ID  menu_cmd_t
	MENUITEM SEPARATOR
	MENUITEM "(c)   Cast spell" ID  menu_cmd_c
	MENUITEM "(d)   Known items" ID  menu_cmd_d
	MENUITEM SEPARATOR
	MENUITEM "(.)    Rest" ID  menu_cmd_rest
	MENUITEM "(^)   ID trap" ID  menu_cmd_trap
	MENUITEM "(F)   Fight" ID  menu_cmd_F
	MENUITEM "(Z)   Teleport" ID  menu_cmd_Z
	MENUITEM SEPARATOR
	MENUITEM "($)   Drop gold" ID  menu_cmd_gold
	MENUITEM "(w)   Pack weight" ID  menu_cmd_w
	MENUITEM "(s)   Tax status" ID  menu_cmd_s
    END
    PULLDOWN "iLarn"
    BEGIN
	MENUITEM "Instructions   "      ID menu_mainMoveInstruct
        MENUITEM "About iLarn   "       ID menu_mainAbout
	MENUITEM SEPARATOR
        MENUITEM "Preferences   "        ID menu_mainSettings "R"
        MENUITEM "Bindings   "        ID menu_mainButtons "B"
	MENUITEM SEPARATOR
        MENUITEM "Beam iLarn!"       ID menu_mainBeam
    END
END
//    PULLDOWN "Wiz"
//    BEGIN
//	MENUITEM "Enlight" ID  menu_main_wiz1
//	MENUITEM "XP" ID  menu_main_wiz2
//	MENUITEM "Up" ID  menu_main_wiz3
//	MENUITEM "Down" ID  menu_main_wiz4
//    END



FORM ID MapForm AT (0 0 160 160)
USABLE
NOFRAME
BEGIN
END


STRING IntroStr "Your daughter has caught dianthroritis, and only "\
		"the rare potion of cure dianthroritis can save her.  "\
		"It is said to lie in the caverns of Ularn, deep in the "\
		"volcano.  Find it and bring it home before her time "\
		"runs out.  (The doctor at Home tells you how long "\
		"she has.)\n\n"\
		"MOVING\n"\
		"Imagine the screen is an eight-point compass, and tap "\
		"in the direction you want to go.  Tap near the middle "\
		"to walk one step, further out to run.  (Preferences "\
		"sets the sizes, and 'Relative move' makes it relative "\
		"to where you are.)  Walk into a monster to attack it.\n"\
		"5-way navigator (Tungsten C etc.): up / down / left / "\
		"right walk (with caps lock on, run); centre rests a "\
		"turn.  In lists, up / down pick, centre chooses and "\
		"left cancels; in the 4-button popup the 5-way moves "\
		"the frame and centre presses.\n"\
		"Keyboard: Bindings > Enable hjklyubn, then h j k l y u "\
		"b n walk and H J K L Y U B N run.\n\n"\
		"THINGS\n"\
		"Step onto something to get a popup of what you can do "\
		"with it: take, drink, read, go in, climb down...  To "\
		"see the popup again, rest ( . ) on the spot.  "\
		"Things are shown in an inverted (coloured) block; "\
		"monsters are plain letters.\n\n"\
		"COMMANDS\n"\
		"See the Commands menu, or write the letter in "\
		"brackets.  Inventory ( i ) is where you use, wield, "\
		"wear and drop things.  To cast a spell ( c ) or Fight "\
		"( F ), pick it and then tap a direction (or tap the "\
		"middle to cancel).\n\n"\
		"The full manual is the iLarn Manual e-book "\
		"(iLarn-manual.pdb), for any Palm DOC reader."

//static char copyright[]=
