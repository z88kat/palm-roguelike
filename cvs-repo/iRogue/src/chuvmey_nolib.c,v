void invert_crosshairs()
{
  Short ox = rogue_xor_x0, oy = rogue_xor_y0;
  Short x1, y1, x2, y2, i;
  // delta1 = 10 * walk_search / sqrt(3) = 5.7735 * walk_search ~= 23/4 * w_s
  Short delta1 = (23*my_prefs.walk_search_border)/4; // 23/4 ~= 10/sqrt(3)
