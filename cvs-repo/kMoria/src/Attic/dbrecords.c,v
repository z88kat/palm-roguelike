// I imagine that c_list is read-only.  For this and treasure type,
// I can just Query the record at application start time and release
// the handle at application exit.  Then it will basically look like a
// regular array of struct.
VoidHand creature_handle = 0;
creature_type * lock_creature_list()
{
  Ptr p;
  UInt index;
  ULong uniqueID = REC_CREATURELIST;
  creature_type *c;
  if (DmFindRecordByID(MoriaDB, uniqueID, &index)) return 0;
  creature_handle = DmQueryRecord(MoriaDB, index);
  p = MemHandleLock(rec);
  c = (creature_type *) p;
  return c;
}
void unlock_creature_list()
{
  if (creature_handle)
    MemHandleUnlock(creature_handle);
  creature_handle = 0;
}

