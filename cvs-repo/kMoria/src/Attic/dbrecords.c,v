// The order that you have learned spells is written to a record.
// (This is so that you forget most-recently-learned spells first,
// and also re-learn in the same order you learned in.)
// This must be set to all 99's when a new character is created.
// (Ick.  Can't I just set it to zeros?)
/*
 *  newrec_spellorder
 *  REQUIRES: REC_SPELLORDER record does not exist in save db
 *  RESULT:   empty record of appropriate size is created
 */
void newrec_spellorder()
{
  // create empty record in MoriaSaveDB
  VoidHand rec;
  Ptr p;
  Int i, size;
  UInt index;
  ULong uniqueID = REC_SPELLORDER;

  index = DmNumRecords(MoriaSaveDB);
  size = sizeof(UChar) * 32;

  rec = DmNewRecord(MoriaSaveDB, &index, size);
  p = MemHandleLock(rec);
  DmSet(p, 0, size, 0);  // set it all to 0.  i think that will work.
  MemPtrUnlock(p);
  DmReleaseRecord(MoriaSaveDB, index, true);
  DmSetRecordInfo(MoriaSaveDB, index, NULL, &uniqueID); // set its uid!
}
/*
 *  reset_spell_order
 *  REQUIRES: REC_SPELLORDER record exists in save db
 *  RESULT:   zeroes the record
 */
void reset_spell_order()
{
  VoidHand rec;
  Ptr p;
  UInt index;
  ULong uniqueID = REC_SPELLORDER;
  Int size;
  UChar val = NO_SPELL; // well actually Byte==UChar anyway

  if (DmFindRecordByID(MoriaSaveDB, uniqueID, &index)) return;
  rec = DmGetRecord(MoriaSaveDB, index);
  p = MemHandleLock(rec);
  DmSet(p, 0, MAX_SPELLORDER, (Byte) val);  // set it all to 99.
  MemPtrUnlock(p);
  DmReleaseRecord(MoriaSaveDB, index, true);
}
// The spell order table is write-once (per lifetime).
/*
 *  write_spell_order
 *  IN: spell player just learned, globals
 *  REQUIRES: record exists
 *  RESULT:   write spell in next empty slot, update empty-slot-index global
 */
void write_spell_order(Short new_spell, everything *env)
{
  VoidHand rec;
  Ptr p;
  UInt index;
  ULong uniqueID = REC_SPELLORDER;

  if (env->last_known_spell >= MAX_SPELLORDER)
    return; // that should not happen...
  // write new_spell to index env->last_known_spell
  if (DmFindRecordByID(MoriaSaveDB, uniqueID, &index)) return;
  rec = DmGetRecord(MoriaSaveDB, index);
  p = MemHandleLock(rec);
  DmWrite(p, sizeof(Short) * env->last_known_spell, new_spell, sizeof(Short));
  env->last_known_spell++; // because it points to first "empty" slot
  MemPtrUnlock(p);
  DmReleaseRecord(MoriaSaveDB, index, true);
}
// a spell to forget or re-learn
/*
 *  get_spell_order
 *  IN: index i
 *  REQUIRES: record exists
 *  RESULT:   return the i'th spell learned
 */
Short get_spell_order(Short i)
{
  // return the i'th spell learned
  VoidHand rec;
