static void charsummary_draw_swapbot()
{
  FormPtr frm = FrmGetActiveForm();
  ControlPtr btn;
  RectangleType r;
  Short x, y, btn_top;
  x = 0; y = ROW_4;

  FrmGetObjectBounds(frm, FrmGetObjectIndex(frm, btn_charsum_ok), &r);
