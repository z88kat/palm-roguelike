void xread_by(FILE *fin, unsigned char *uc, int n)
{
  int i;
  unsigned char ctmp;
  for (i = 0 ; i < n ; i++) {
    fread(&ctmp, 1, 1, fin);
    uc[i] = (xb ^ ctmp);
    xb = ctmp;
  }
}


// Read at most n characters of (supposed to be null terminated) string
void xread_str(FILE *fin, char *buf, int n)
{
  int i;
  unsigned char ctmp, c;
  for (i = 0 ; i < n ; i++) {
    fread(&ctmp, 1, 1, fin);
    c = (xb ^ ctmp);
    xb = ctmp;
    buf[i] = c;
    if (c == '\0') return;
  }
}

// Read at most n characters of (supposed to be null terminated) string
void xuncopy_str(FILE *fout, FILE *fin, int n)
{
  int i;
  unsigned char ctmp, c;
#ifdef NOISY
  if (Noisy)
    printf("\"");
#endif
  for (i = 0 ; i < n ; i++) {
    fread(&ctmp, 1, 1, fin);
    c = (xb ^ ctmp);
#ifdef NOISY
  if (Noisy)
    printf("%c", c);
#endif
    xb = ctmp;
    fwrite(&c, 1, 1, fout);
    if (c == '\0') break;
  }
  // caller may need to pad the rest of 'n', or skip over it.
#ifdef NOISY
  if (Noisy)
    printf("\"\n");
#endif
}


void xuncopy_by(FILE *fout, FILE *fin, int n)
{
  int i;
  unsigned char ctmp, c;
#ifdef NOISY
    if (Noisy)
      printf("at %ld: ",ftell(fin));
#endif
  for (i = 0 ; i < n ; i++) {
    fread(&ctmp, 1, 1, fin);
    c = (xb ^ ctmp);
    xb = ctmp;
    fwrite(&c, 1, 1, fout);
#ifdef NOISY
    if (Noisy)
      printf("%d ",c);
#endif
  }
#ifdef NOISY
  if (Noisy)
    printf("\n");
#endif
}
// do NOT do "in_"anything, it will mess up the xoring order.
// do "out_"things instead.

void xuncopy_sh(FILE *fout, FILE *fin, int n)
{
  int i, j;
  unsigned short ustmp = 0;
  unsigned char c[2], ctmp;
  for (i = 0 ; i < n ; i++) {
    // low byte will be in 0
    for (j = 0 ; j < 2 ; j++) {
      fread(&ctmp, 1, 1, fin);
      c[j] = (xb ^ ctmp);
      xb = ctmp;
    }
    // combine, and possibly swap on the way out
    ustmp = c[0] | (c[1] << 8);
    out_word(fout, ustmp);
  }
}


void xread_sh(FILE *fin, unsigned short *us, int n)
{
  int i, j;
  unsigned short ustmp = 0;
  unsigned char ctmp, c[2];
  for (i = 0 ; i < n ; i++) {
    // low byte will be in 0
    for (j = 0 ; j < 2 ; j++) {
      fread(&ctmp, 1, 1, fin);
      c[j] = (xb ^ ctmp);
      xb = ctmp;
    }
    // combine, and possibly swap on the way out
    ustmp = c[0] | (c[1] << 8);
    us[i] = ustmp; //SwapWord(ustmp);
  }
}


void xuncopy_lo(FILE *fout, FILE *fin, int n)
{
  int i, j;
  unsigned long ultmp = 0;
  unsigned char ctmp, c[4];
  for (i = 0 ; i < n ; i++) {
    // low byte will be in 0
    for (j = 0 ; j < 4 ; j++) {
      fread(&ctmp, 1, 1, fin);
      c[j] = (xb ^ ctmp);
      xb = ctmp;
    }
    // combine, and possibly swap on the way out
    ultmp = c[0] | (c[1] << 8) | (c[2] << 16) |  (c[3] << 24);
    out_long(fout, ultmp);
  }
}


void xread_lo(FILE *fin, unsigned long *ul, int n)
{
  int i, j;
  unsigned long ultmp = 0;
  unsigned char ctmp, c[4];
  for (i = 0 ; i < n ; i++) {
    // low byte will be in 0
    for (j = 0 ; j < 4 ; j++) {
      fread(&ctmp, 1, 1, fin);
      c[j] = (xb ^ ctmp);
      xb = ctmp;
    }
    // combine, and possibly swap on the way out
    ultmp = c[0] | (c[1] << 8) | (c[2] << 16) |  (c[3] << 24);
    ul[i] = ultmp; // SwapLong(ultmp);
  }
}
