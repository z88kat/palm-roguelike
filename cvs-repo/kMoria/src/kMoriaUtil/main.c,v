static void write_version_rec()
{
  // create a version record
  //  ULong uniqueID;
  UInt index = REC_COLOR_VERSION, version = MoriaColorDBVersion;
  VoidHand vh;
  ULong size = sizeof(UInt);
  VoidPtr p = NULL;
  // lock record
  //if (0!=DmFindRecordByID(MoriaColorDB, uniqueID, &index)) {
  if (DmNumRecords(MoriaColorDB) <= index)
    // XXX will this create with right index
    // create new record if it doesn't exist
    vh = DmNewRecord(MoriaColorDB, &index, size);
  else
    vh = DmGetRecord(MoriaColorDB, index);
  p = MemHandleLock(vh);
  DmWrite(p, 0, &version, sizeof(UInt));
  // unlock record
  MemHandleUnlock(vh);
  DmReleaseRecord(MoriaColorDB, index, true);
  //DmSetRecordInfo(MoriaColorDB, index, NULL, &uniqueID); // set its uid!
}

static void creaturelist_record_lock(Boolean unlocked)
{
  UInt index = REC_CREATURELIST;
  static VoidHand vh;
  VoidPtr p = NULL;
  if (unlocked) {
    // lock record
    vh = DmQueryRecord(MoriaDB, index);
    p = MemHandleLock(vh);
    c_list = (creature_type *) p;
  } else {
    // unlock record
    if (c_list != NULL) {
      c_list = NULL;
      MemHandleUnlock(vh);
    }
  }
}
static void cnames_record_lock(Boolean unlocked)
{
  UInt index = REC_CLIST_NAMES;
  static VoidHand vh;
  VoidPtr p = NULL;
  if (unlocked) {
    // lock record
    vh = DmQueryRecord(MoriaDB, index);
    p = MemHandleLock(vh);
    c_names = (Char *) p;
  } else {
    // unlock record
    if (c_names != NULL) {
      c_names = NULL;
      MemHandleUnlock(vh);
    }
  }
}

#define MAX_ASCII 95
