void write_py_etc(FILE *fout, FILE *fin)
{
  long position;
  char trash;
  fseek(fin, offsets[O_PY], SEEK_SET);
  write_player_misc(fout, fin);
  position = ftell(fin);
  write_player_hist(fout, fin);
  fseek(fin, position, SEEK_SET);
  write_player_stats(fout, fin); // we are ok through stats. rest untested.
  write_player_flags(fout, fin);
  // now we must make up for its 'odd' size:
  fread(&trash, 1, 1, fin);
  //
  // ok... now we are at player_hp (in kMoriaSaveDB).
  // but what we need to write (in moria.save) is different random cruft.
  //
  // Let's save our file position so we can jump back later!!!
  player_hp_position = ftell(fin);
  get_player_leftovers(fin);
}

