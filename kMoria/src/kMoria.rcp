FORM ID RecallForm AT (2 2 156 156)
USABLE
MODAL
MENUID RecallFormMenu
BEGIN
    TITLE "abcdefghijklmnopqrstuvwxyz "
    FIELD ID field_recall AT (5 15 146 121) NONEDITABLE MULTIPLELINES MAXCHARS 3000
    REPEATBUTTON "\001" ID repeat_recall_up AT (144 139 10 AUTO) NOFRAME FONT 5 
    REPEATBUTTON "\002" ID repeat_recall_down AT (144 147 10 AUTO) NOFRAME FONT 5 
    BUTTON "Done" ID btn_recall_ok AT (5 139 AUTO AUTO)
    BUTTON "Next" ID btn_recall_next AT (PrevRight+5 PrevTop AUTO AUTO) NONUSABLE
END

MENU ID RecallFormMenu
BEGIN
    PULLDOWN "Options"
    BEGIN
        MENUITEM "Amnesia" ID menu_recClear "A"
    END
END


