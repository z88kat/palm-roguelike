 *  newrec_playerexp
 *  REQUIRES: experience levels, above;  no REC_PLAYEREXP in main db
 *  RESULT:   record is created and initialized with that data
 */
void newrec_playerexp() {
  VoidHand rec;
  Ptr p;
  Int size;
  UInt index;
  ULong uniqueID = REC_PLAYEREXP;
  Short qty = MAX_PLAYER_LEVEL;
  Short sze = sizeof(ULong);
  Short i, offset;
  index = DmNumRecords(MoriaDB);
  size = qty * sze;
  rec = DmNewRecord(MoriaDB, &index, size);
  p = MemHandleLock(rec);
  // print stuff to it.
  for (i = 0, offset = 0 ; i < qty; i++, offset += sze)
    DmWrite(p, offset, player_exp[i], sze);
  MemPtrUnlock(p);
  DmReleaseRecord(MoriaDB, index, true);
  DmSetRecordInfo(MoriaDB, index, NULL, &uniqueID); // set its uid!
}
/*
 *  get_player_exp
 *  IN: player level of interest
 *  REQUIRES: record exists
 *  RESULT:   returns the minimum experience to be that level, or 0 on failure!
 */
ULong get_player_exp(Short plevel)
{
  VoidHand rec;
  Ptr p;
  UInt index;
  ULong uniqueID = REC_PLAYEREXP;
  ULong *exps;
  ULong val;
  // look up and return the correct number
  plevel--; // the 0th entry is "exp needed to reach level 1", etc.
  // bounds check
  if (plevel < 0 || plevel >= MAX_PLAYER_LEVEL) return 0;
  if (DmFindRecordByID(MoriaDB, uniqueID, &index)) return 0;
  rec = DmQueryRecord(MoriaDB, index);
  p = MemHandleLock(rec);
  exps = (ULong *) p;
  val = exps[plevel];
  MemHandleUnlock(rec);
  return val;
}

