void get_player_leftovers(FILE *fin)
{
  int i;
  long position = player_hp_position;
  short stmp;
  unsigned long ltmp;
  position += sizeof(short) * MAX_PLAYER_LEVEL; // skip over player_hp.
  position += sizeof(char) * (MAX_SPELLS+1); // skip over spell_order
  fseek(fin, position, SEEK_SET);
  for (i=0 ; i<8 ; i++) {
    ltmp = in_long(fin);
    my_save.ul[i] = ltmp;
  }
  printf("\n");
  for (i=0 ; i<6 ; i++) {
    stmp = in_word(fin);
    my_save.us[i] = stmp;
  }
  for (i=0 ; i<2 ; i++)
    fread(&my_save.uc[i], 1, 1, fin);
  fread(my_save.died_from, 1, 25, fin);
  position = player_hp_position;
  position += sizeof(short) * MAX_PLAYER_LEVEL; // skip over player_hp.
  position += sizeof(char) * (MAX_SPELLS+1); // skip over spell_order
  position += sizeof(my_save);
  fseek(fin, position, SEEK_SET);
  for (i=0 ; i<8 ; i++)
    floor_save.us[i] = in_word(fin);
}


