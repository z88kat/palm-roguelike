    //    lab[0] = SNOR;    lab[1] = TAKE;    lab[2] = ZZZZ;    lab[3] = IGNO;
    switch(button) {
    case 0:
      drug_coke();
      forget();      
      break;
    case 1:
      if (take(OCOKE, 0, true))   forget();
      else return false;
      break;
