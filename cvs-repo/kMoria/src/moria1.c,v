   The second arg indicates a light change. */
void disturb(Boolean se, Boolean li)
{
  command_count = 0;
  if (se && (pyflags.status & PY_SEARCH))
    search_off();
  if (pyflags.rest != 0)
    rest_off();
  if (li || (find_flag > 0)) {
    find_flag = 0; // false;
    check_view();
  }
  //  flush();
}



