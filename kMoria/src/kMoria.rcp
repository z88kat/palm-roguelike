FORM ID RestForm AT (2 93 156 65)
USABLE
MODAL
DEFAULTBTNID btn_rest_oops
BEGIN
	TITLE "Rest how many turns?"
	LABEL "..Or rest until hit points and" AUTOID AT (4 15)
	LABEL "mana reach maximum?" AUTOID AT (PrevLeft PrevBottom)
  BUTTON "0" ID btn_rest_oops AT (5 47 27 13)
  BUTTON "10" ID btn_rest_10 AT (PrevRight+6 PrevTop 32 13)
  BUTTON "20" ID btn_rest_20 AT (PrevRight+6 PrevTop 32 13)
  BUTTON "Max!" ID btn_rest_max AT (PrevRight+6 PrevTop 37 13)
END




// alert can be INFORMATION, CONFIRMATION, WARNING, ERROR.
//             (i)           (?)           /!\     ( X )
//              v             v            ---

ALERT ID QuitP
WARNING
DEFAULTBUTTON 1
BEGIN
	TITLE "Really Quit?"
	MESSAGE "Do you really want to quit?  This will kill your current character."
	BUTTON "Ok" "Cancel"
END

ALERT ID RetireP
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
	TITLE "Ready to Retire?"
	MESSAGE "Are you ready to retire this character?"
	BUTTON "Ok" "Cancel"
END

ALERT ID CrashP
WARNING
DEFAULTBUTTON 1
BEGIN
	TITLE "Crash recovery"
	MESSAGE "I think you crashed.  I can try to recover your character."
	BUTTON "Just Quit" "Recover Me"
END


ALERT ID DropAllP
CONFIRMATION
DEFAULTBUTTON 0
BEGIN
	TITLE "Drop All?"
	MESSAGE "Drop all ^1"
	BUTTON "All" "Just one"
END

ALERT ID BeamNextP
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
	TITLE "Ready?"
	MESSAGE "Ready to beam the next piece?"
	BUTTON "Ok" "Cancel"
END

// (this situation can never occur)
//ALERT ID DropWornP
//ERROR
//DEFAULTBUTTON 1
//BEGIN
//	TITLE "Drop?"
//	MESSAGE "You can't carry ^1  Drop it?"
//	BUTTON "Yes" "No"
//END

ALERT ID ExceedP
WARNING
DEFAULTBUTTON 1
BEGIN
	TITLE "Weight Limit"
	MESSAGE "Exceed your weight limit to pick up ^1"
	BUTTON "Ok" "Cancel"
END

ALERT ID PickupP
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
	TITLE "Pick Up?"
	MESSAGE "Pick up ^1"
	BUTTON "Ok" "Cancel"
END

ALERT ID CursedP
ERROR
DEFAULTBUTTON 0
BEGIN
	TITLE "Can't..."
	MESSAGE "The ^1 you are ^2 appears to be cursed."
	BUTTON "Oh, bother."
END

ALERT ID RingHandP
CONFIRMATION
DEFAULTBUTTON 0
BEGIN
	TITLE "Which Hand?"
	MESSAGE "Put ring on which hand?\n"\
		"L: ^1\n"\
		"R: ^2"
	BUTTON "Left" "Right"
END

ALERT ID LowMageP
INFORMATION
DEFAULTBUTTON 1
BEGIN
	TITLE "Low Mana..."
	MESSAGE "You summon your limited strength to cast this one!  Confirm?"
	BUTTON "Ok" "Cancel"
END

ALERT ID LowPriestP
INFORMATION
DEFAULTBUTTON 1
BEGIN
	TITLE "Low Mana..."
	MESSAGE "The gods may think you presumptuous for this! Confirm?"
	BUTTON "Ok" "Cancel"
END



ALERT ID RecallClearP
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
	TITLE "Clear Monster Memory"
	MESSAGE "Are you sure you want to erase all knowledge you've accumulated about monsters?"
	BUTTON "Ok" "Cancel"
END

ALERT ID RecallClear2P
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
	TITLE "Clear Monster Memory"
	MESSAGE "Are you really, really sure?"
	BUTTON "Ok" "Cancel"
END


ALERT ID DigSlowlyP
CONFIRMATION
DEFAULTBUTTON 0
BEGIN
	TITLE "Dig with..."
	MESSAGE "...^1"
	BUTTON "Ok" "Cancel"
END


