  if (!plugged_in) {
    Short v = volts_times_100/100, vdec = volts_times_100 % 100;
    StrPrintF(buf+len, "  %c   %d%s%d V", EMDASH, v,
	      (vdec<10 ? ".0" : "."), vdec);
    if (battpercent) {
      len = StrLen(buf);
      StrPrintF(buf+len, " (%d%%)", battpercent);
    }
  } else {
    StrPrintF(buf+len, "  %c   [charging]", EMDASH);
  }
