**********************************************************************/
extern Short ScrHeight;
extern Short ScrMsgHt;
extern Short ScrStatsHt;
void explain_it(Short x, Short y)
{
  Short row, col, mch, ch;
  //  Char buf[10];

  if (y < ScrMsgHt) // 22 or less, for 160x160
    message("message window");
  else if (y >= ScrHeight - ScrStatsHt) // 137 or more, for 160x160
    message("vital statistics of your rogue");
  else {
    ch = what_row_col(x, y, &row, &col);
    //    ch = mvinch(row, col);
    if (Is_Alpha(ch)) {
      if (ch > 'Z')
	mch = 26 + (ch - 'a'); // 97=='a' 65=='A'
      else
	mch = ch - 'A';
      print_mon_name(mch);
    } else {
      switch(ch) {
      case ' ':
	message("nothing is visible there");
	return;
      case '?':
	message("scroll");
	return;
      case '!':
	message("potion");
	return;
      case '*':
	message("some gold");
	return;
      case -80:
	// FOODCHAR
	message("some food");
	return;
      case '/':
	message("wand");
	return;
      case ']':
	message("armor");
	return;
      case ')':
	message("weapon");
	return;
      case '=':
	message("ring");
	return;
      case ',':
	message("amulet");
	return;
      case '.':
	message("the floor");
	return;
      case '+':
	message("door");
	return;
      case '#':
	message("tunnel");
	return;
      case '|':
      case -105:
	// EMDASH
	message("wall");
	return;
      case '^':
	message("trap");
	return;
      case '%':
	message("stairs");
	return;
      case '@@':
	message("that's you");
	return;
      default:
	//	StrPrintF(buf, "%d", ch);
	message("...beats me");
	//      message(buf);
	return;
      }
    }
  }
}
