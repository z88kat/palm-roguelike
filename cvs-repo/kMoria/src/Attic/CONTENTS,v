Boolean save_char()
{
  while (_save_char() fails) {
    if the file exists, prompt to delete it,
    or prompt to change filename or something
  }
}

Boolean _save_char(filename)
{
  if character_saved return true;  // (seems like I can skip that.)

  disturb (1, 0);		/* Turn off resting and searching. */
  change_speed(-pack_heavy);	/* Fix the speed */
  pack_heavy = 0;

  write 4 bytes:  major version, minor version, patchlevel, and a random char.
  xor_byte = the random char.  (I guess this is to "encrypt" the file?)
  then call sv_write
  and if it succeeds, set character_saved true and return true.
  
}

