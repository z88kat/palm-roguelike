unsigned char xb = 0;
void xwrite_by(FILE *fout, unsigned char *uc, int n)
{
  int i;
  unsigned char ctmp;
  for (i = 0 ; i < n ; i++) {
    ctmp = uc[i];
    xb = (xb ^ ctmp);
    fwrite(&xb, 1, 1, fout);
  }
}
void xcopy_by(FILE *fout, FILE *fin, int n)
{
  int i;
  unsigned char ctmp;
  for (i = 0 ; i < n ; i++) {
    fread(&ctmp, 1, 1, fin);
    xb = (xb ^ ctmp);
    fwrite(&xb, 1, 1, fout);
  }
}
// Write at most n characters of (supposed to be null terminated) string
void xwrite_str(FILE *fout, char *str, int n)
{
  int i;
  str[n-1] = '\0'; // just to be sure.
  for (i = 0 ; i < n ; i++) {
    xb = (xb ^ str[i]);
    fwrite(&xb, 1, 1, fout);
    if (str[i] == '\0')
      break;
  }
}
void xwrite_sh(FILE *fout, unsigned short *us, int n)
{
  int i;
  unsigned short ustmp;
  unsigned char tmp;
  for (i = 0 ; i < n ; i++) {
    ustmp = us[i];
    tmp = (ustmp & 0xff); // throw away the high byte
    xb = (xb ^ tmp);
    fwrite(&xb, 1, 1, fout);
    //
    ustmp = ustmp >> 8;
    tmp = (ustmp & 0xff);
    xb = (xb ^ tmp);
    fwrite(&xb, 1, 1, fout);
  }
}
void xcopy_sh(FILE *fout, FILE *fin, int n)
{
  int i;
  unsigned short ustmp;
  unsigned char tmp;
  for (i = 0 ; i < n ; i++) {
    ustmp = in_word(fin);
    tmp = (ustmp & 0xff); // throw away the high byte
    xb = (xb ^ tmp);
    fwrite(&xb, 1, 1, fout);
    //
    ustmp = ustmp >> 8;
    tmp = (ustmp & 0xff);
    xb = (xb ^ tmp);
    fwrite(&xb, 1, 1, fout);
  }
}
