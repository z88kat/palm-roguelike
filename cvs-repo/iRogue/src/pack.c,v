  if (!(dungeon[rogue->row][rogue->col] & OBJECT)) {
    message("nothing here", sotu);
    return;
  }
  if ((obj = pick_up(rogue->row, rogue->col, &status))) {
    get_desc(obj, desc, sotu);
    if (obj->what_is == GOLD) {
      free_object(obj, sotu);
    } else {
      n = StrLen(desc);
      desc[n] = '(';
      desc[n+1] = obj->ichar;
      desc[n+2] = ')';
      desc[n+3] = 0;
    }
    message(desc, sotu);
  }
  if (obj || (!status))
    reg_move();
}
