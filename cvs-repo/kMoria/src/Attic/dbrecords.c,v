/*
 *  get_player_exp
 *  IN: player level of interest
 *  REQUIRES: record exists
 *  RESULT:   returns the minimum experience to be that level
 */
UShort get_normal_tab(Short i)
{
  VoidHand rec;
  Ptr p;
  UInt index;
  ULong uniqueID = REC_NORMALTAB;
  UShort *vals;
  UShort val;
  // look up and return the correct number
  // bounds check
  if (i < 0 || i >= NORMAL_TABLE_SIZE) return 0;
  // perform lookup
  if (DmFindRecordByID(MoriaDB, uniqueID, &index)) return 0;
  rec = DmQueryRecord(MoriaDB, index);
  p = MemHandleLock(rec);
  vals = (UShort *) p;
  val = vals[i];
  MemHandleUnlock(rec);
  return val;
}



