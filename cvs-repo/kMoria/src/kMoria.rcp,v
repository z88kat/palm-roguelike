FORM ID MainForm AT (0 0 160 160)
USABLE
NOFRAME
MENUID MainFormMenu
BEGIN
    GRAFFITISTATEINDICATOR AT (150 150)
END

//	MENUITEM "Wizard" ID  menu_mainWiz
MENU ID MainFormMenu
BEGIN
    PULLDOWN "Show"
    BEGIN
        MENUITEM "Map  "           ID menu_mainMap "M"
	MENUITEM "Message Log   "          ID menu_mainMsgs "L"
        MENUITEM "Your Stats   "       ID menu_mainStats "Y"
	MENUITEM SEPARATOR
        MENUITEM "(/)    What's that?"       ID menu_mainRecall
	MENUITEM "(?)    Look at" ID  menu_cmd_look
	MENUITEM "(-)    Next sector" ID  menu_cmd_minus
	MENUITEM SEPARATOR
	MENUITEM "Instructions   "      ID menu_mainInstruct
        MENUITEM "About kMoria   "       ID menu_mainAbout
	MENUITEM "High Scores" ID  menu_mainScores
	MENUITEM SEPARATOR
	MENUITEM "QUIT" ID  menu_cmd_quit "Q"
    END
    PULLDOWN "Pick"
    BEGIN
	MENUITEM "(i)      Inventory..." ID  menu_cmd_i
	MENUITEM "(e)    Equipment..." ID  menu_cmd_e
	MENUITEM "(m)   Magic spell..." ID  menu_cmd_m
	MENUITEM "(p)    Pray..." ID  menu_cmd_p
	MENUITEM "(G)   Gain spells" ID  menu_cmd_G
	MENUITEM SEPARATOR
	MENUITEM "(t)    Throw" ID  menu_cmd_t
	MENUITEM "(a)    Aim wand" ID  menu_cmd_a
	MENUITEM "(z)     Zap staff" ID  menu_cmd_z
	MENUITEM "({)     Inscribe" ID  menu_cmd_scribe
	MENUITEM SEPARATOR
	MENUITEM "(g)    Again" ID  menu_cmd_g
    END
    PULLDOWN "Here"
    BEGIN
	MENUITEM "(x)    Exchange" ID  menu_cmd_x
	MENUITEM "(r)    Rest" ID  menu_cmd_r
	MENUITEM SEPARATOR
	MENUITEM "(s)    Search" ID  menu_cmd_s
	MENUITEM "(#)  ... mode" ID  menu_cmd_pound
	MENUITEM SEPARATOR
	MENUITEM "(<)    Ascend" ID  menu_cmd_lt
	MENUITEM "(>)    Descend" ID  menu_cmd_gt
    END
    PULLDOWN "Near"
    BEGIN
	MENUITEM "(c)    Close" ID  menu_cmd_c
	MENUITEM "(o)    Open" ID  menu_cmd_o
	MENUITEM "(f)    Force" ID  menu_cmd_f
	MENUITEM "(S)    Spike" ID  menu_cmd_S
	MENUITEM SEPARATOR
	MENUITEM "(d)    Dig" ID  menu_cmd_d
	MENUITEM "(  )     Move onto" ID  menu_cmd_space
	MENUITEM "(^)    Disarm" ID  menu_cmd_disarm
    END
    PULLDOWN "Set"
    BEGIN
        MENUITEM "Preferences "        ID menu_mainSettings
        MENUITEM "Buttons   "        ID menu_mainButtons
        MENUITEM "Repeaters   "        ID menu_mainRepeaters
        MENUITEM "Spell Btns   "        ID menu_mainSpellBtns
	MENUITEM SEPARATOR
	MENUITEM "Beam..." ID  menu_mainBeam
	MENUITEM "User..." ID  menu_mainUser "U"
	MENUITEM SEPARATOR
	MENUITEM "Font" ID  menu_mainFont "F"
	MENUITEM "(!)  Stats mode" ID  menu_cmd_bang
	MENUITEM "Show time" ID  menu_mainTime "T"
    END
END
