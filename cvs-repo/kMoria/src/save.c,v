// called to lock on creation or start, and (from lock.c) to unlock on exit
Boolean py_record_lock(Boolean unlocked) // called from lock.c, unlocked=false
{
  ULong uniqueID;
  static UInt index;
  static VoidHand vh;
  //  VoidPtr p;
  if (unlocked) {
    // lock record
    uniqueID = REC_PY;
    if (0!=DmFindRecordByID(MoriaSaveDB, uniqueID, &index)) return false;
    vh = DmGetRecord(MoriaSaveDB, index);
    locked_py_rec = MemHandleLock(vh);
  } else {
    // unlock record
    if (locked_py_rec != NULL) {
      locked_py_rec = NULL;
      MemHandleUnlock(vh);
      DmReleaseRecord(MoriaSaveDB, index, true);
    }
  }
  return true;
}

