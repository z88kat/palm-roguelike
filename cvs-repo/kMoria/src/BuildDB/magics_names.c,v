void newrec_magics_names()
{
  ULong uniqueID;
  VoidHand rec;
  Ptr p;
  ULong size = 0, offset;
  UInt index;
  Short i;
  size += MAX_AMULETS * MAXLEN_AMULETS;
  size += MAX_ROCKS * MAXLEN_ROCKS;
  size += MAX_WOODS * MAXLEN_WOODS;
  size += MAX_METALS * MAXLEN_METALS;
  size += MAX_COLORS * MAXLEN_COLORS;
  size += MAX_MUSH * MAXLEN_MUSH;
  size += MAX_SYLLABLES * MAXLEN_SYLLABLES;
  size += SN_ARRAY_SIZE * MAXLEN_SPECNAME;
  size *= sizeof(Char);

  uniqueID = REC_MAGICS;
  if (0 == DmFindRecordByID(MoriaDB, uniqueID, &index))
    DmRemoveRecord(MoriaDB, index);      // EX TERM IN ATE !
  index = DmNumRecords(MoriaDB);
  rec = DmNewRecord(MoriaDB, &index, size);
  p = MemHandleLock(rec);
  if (!p) goto cleanup;
  // print stuff to it.  actually DmStrCopy might be a smarter idea.
  DmSet(p, 0, size, 0); // so that we have null padding after runty strings!
  offset = 0;
  // Wonder if this will work.
  for (i = 0 ; i < MAX_AMULETS ; i++, offset += MAXLEN_AMULETS)
    DmStrCopy(p, offset, my_amulets[i]);
  for (i = 0 ; i < MAX_ROCKS ; i++, offset += MAXLEN_ROCKS)
    DmStrCopy(p, offset, my_rocks[i]);
  for (i = 0 ; i < MAX_WOODS ; i++, offset += MAXLEN_WOODS)
    DmStrCopy(p, offset, my_woods[i]);
  for (i = 0 ; i < MAX_METALS ; i++, offset += MAXLEN_METALS)
    DmStrCopy(p, offset, my_metals[i]);
  for (i = 0 ; i < MAX_COLORS ; i++, offset += MAXLEN_COLORS)
    DmStrCopy(p, offset, my_colors[i]);
  for (i = 0 ; i < MAX_MUSH ; i++, offset += MAXLEN_MUSH)
    DmStrCopy(p, offset, my_mushrooms[i]);
  for (i = 0 ; i < MAX_SYLLABLES ; i++, offset += MAXLEN_SYLLABLES)
    DmStrCopy(p, offset, my_syllables[i]);
  for (i = 0 ; i < SN_ARRAY_SIZE ; i++, offset += MAXLEN_SPECNAME)
    DmStrCopy(p, offset, my_special_names[i]);

  /*
  for (i = 0 ; i < MAX_AMULETS ; i++, offset += MAXLEN_AMULETS)
    DmWrite(p, offset, my_amulets[i], sizeof(Char) * MAXLEN_AMULETS);
